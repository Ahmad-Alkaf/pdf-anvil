# All variables are inlined into the client bundle at BUILD time.
# In Coolify, mark each one as "Available at build time".

# Public site URL. Used for metadataBase, canonical URLs, sitemap, robots.
NEXT_PUBLIC_APP_URL=https://pdf-anvil.com

# Self-hosted Umami. Leave both empty to disable analytics (local dev).
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
